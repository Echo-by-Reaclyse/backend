PORT=3000

# JWT signing secret — REQUIRED (app crashes on startup without this)
JWT_SECRET=change-me-use-a-long-random-string

# Apple web Sign In client ID (only needed for web-based Sign In with Apple)
APPLE_WEB_CLIENT_ID=

# Apple Sign In server-to-server notifications
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_APP_BUNDLE_ID=com.reaclyse.echo.ai

# Sentry error monitoring (echo-b4b org → echo-backend project)
SENTRY_DSN=https://3fac381245cc51fe9b5d342f54caf545@o4511596273270784.ingest.de.sentry.io/4511879510884432

# Neon DB (Settings > Connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Resend
RESEND_API_KEY=re_your_api_key
RESEND_WAITLIST_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RESEND_APP_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Slack incoming webhook URLs (Settings > Incoming Webhooks in your Slack app)
SLACK_WAITLIST_WEBHOOK=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_OAUTH_WEBHOOK=https://hooks.slack.com/services/xxx/yyy/zzz
